# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# إعدادات رفع وتخزين الشواهد عبر Google Drive (Google Apps Script Web App)
# تنبيه أمني: المتغيرات هنا يتم قراءتها واستخدامها من طرف خادم Express الخلفي فقط.
# لا يتم إرسال المفتاح السري إلى المتصفح أو تضمينه في كود الواجهة الأمامية أبداً.
# ==============================================================================
# رابط نشر تطبيق Google Apps Script (Web App Exec URL):
GOOGLE_APPS_SCRIPT_URL="PASTE_YOUR_APPS_SCRIPT_EXEC_URL"

# الرمز السري المعتمد للمصادقة بين خادم Express وتطبيق Google Apps Script:
GOOGLE_DRIVE_API_SECRET="PASTE_YOUR_GOOGLE_DRIVE_API_SECRET"

# الحد الأقصى لحجم الملف بالميجابايت (الافتراضي 8 ميجابايت):
GOOGLE_DRIVE_MAX_FILE_SIZE_MB="8"

# ==============================================================================
# إعدادات Firebase (اختيارية - Firestore & Realtime Database)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_DATABASE_URL=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
